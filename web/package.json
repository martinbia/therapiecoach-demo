{
  "name": "therapiecoach-pwa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:adapter",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:unit": "node --experimental-transform-types --test tests/access.test.ts tests/dispatcher.test.ts tests/voice.test.ts",
    "test:adapter": "node --experimental-loader ./tests/sdk-mock-loader.mjs --experimental-transform-types --test tests/elevenlabs-adapter.test.ts"
  },
  "dependencies": {
    "@elevenlabs/client": "1.32.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "@types/node": "22.15.30"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
